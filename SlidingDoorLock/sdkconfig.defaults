# ESP-IDF settings for the Arduino-as-component build (see platformio.ini).
# PlatformIO generates sdkconfig.firebeetle32 from these on the first build; delete that file
# to re-apply changes made here.

# Arduino core
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_FREERTOS_HZ=1000
# logging as in the prebuilt Arduino builds (core debug level 0) - otherwise every
# LittleFS.exists() on a missing settings file logs an error
CONFIG_ARDUHAL_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

# 4 MB flash, same partitions as the Arduino builds: two OTA app slots and LittleFS
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# power management - the CPU light sleeps whenever every task is idle, WiFi stays associated
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
CONFIG_ESP_WIFI_SLP_IRAM_OPT=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_80=y

# LittleFS - match the prebuilt Arduino core
CONFIG_LITTLEFS_MAX_PARTITIONS=3
CONFIG_LITTLEFS_PAGE_SIZE=256
CONFIG_LITTLEFS_OBJ_NAME_LEN=64
CONFIG_LITTLEFS_USE_MTIME=y
CONFIG_LITTLEFS_MTIME_USE_SECONDS=y
